PORT=5173
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Optional authentication for your local inference service. Never sent to browser.
# AI_API_KEY=

# Check public Cebu price sources every six hours while this server runs (5–1440 minutes).
PRICE_REFRESH_MINUTES=360
AUTO_PRICE_REFRESH=true

# npm run share enables access from phones on your trusted Wi-Fi.
# HOST=0.0.0.0
# Optional trusted local TLS certificate/key for HTTPS and mobile PWA installation.
# TLS_CERT=/absolute/path/to/certificate.pem
# TLS_KEY=/absolute/path/to/private-key.pem
# Shared data defaults to .vaind/; keep this directory private and backed up.
# HOUSEHOLD_DATA_DIR=/absolute/path/to/private-data

# Installable phones: npm run mobile prepares local HTTPS without changing trust stores.
# The default setup-only HTTP port is PORT + 1.
# INSTALL_PORT=5174
# Optional private directory for generated CA and server certificate files.
# MOBILE_TLS_DIR=/absolute/path/to/private/tls
